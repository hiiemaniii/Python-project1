        "# PROJECT:- ATM SIMULATOR\n",
        "cp=\"1234\"\n",
        "bal=10000\n",
        "at=0\n",
        "m=\"not logged in\"\n",
        "while at<3:\n",
        "  p=input(\"Enter correct PIN:\")\n",
        "  if p!=cp:\n",
        "    at+=1\n",
        "    if at==3:\n",
        "      print(\"Card blocked\")\n",
        "      break\n",
        "    print(\"Wrong PIN ,\",\"Attempt left : \",3-at)\n",
        "  else:\n",
        "    print(\" LOGGED IN SUCCESSFULLY\")\n",
        "    m=\"logged in\"\n",
        "    break\n",
        "print()\n",
        "l=[]\n",
        "while m==\"logged in\" :\n",
        "  print()\n",
        "  print()\n",
        "  print(\"\"\" ##**##**OPTIONS**##**##\n",
        "          1.Balance\n",
        "          2.Deposit\n",
        "          3.Withdraw\n",
        "          4.Exit\"\"\")\n",
        "  print()\n",
        "  o=int(input(\"Enter your choice:\"))\n",
        "  print()\n",
        "  if o==1:\n",
        "    print(\"Balance:\",\"₹\"+str(bal))\n",
        "  elif o==2:\n",
        "    n=int(input(\"Enter amount you want to deposit: \"))\n",
        "    if n>0:\n",
        "      bal+=n\n",
        "      l.append(\"+\"+str(n))\n",
        "      print(\" New Balance:\",\"₹\"+str(bal))\n",
        "  elif o==3:\n",
        "    n=int(input(\"Enter amount to withdraw : \"))\n",
        "    if bal>n:\n",
        "      bal-=n\n",
        "      l.append(\"-\"+str(n))\n",
        "      print(\"New balance : \",\"₹\"+str(bal))\n",
        "    else:\n",
        "      print(\"Insufficient Balance :(\")\n",
        "\n",
        "  elif o==4:\n",
        "    print(\" Here is all your history \")\n",
        "    for i in range(len(l)):\n",
        "      if l[i].startswith(\"+\"):\n",
        "        print(str(i+1)+\".\",\"Deposit -\",\"₹\"+l[i].replace(\"+\",\"\"))\n",
        "      elif l[i].startswith(\"-\"):\n",
        "        print(str(i+1)+\".\",\"Withdraw -\",\"₹\"+l[i].replace(\"-\",\"\"))\n",
        "\n",
        "    print()\n",
        "    print(\"\"\"THANK YOU\n",
        "    :)     \"\"\")\n",
        "    break\n",
        "\n",
        "  else:\n",
        "    print(\"Invalid Choice!!\")\n",
        "    print(\"Enter again!\")\n"
